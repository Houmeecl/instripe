# Copia a .env y completa para habilitar pasarelas en modo live.
# Sin credenciales, la plataforma corre en modo demo autocontenido.
PORT=3000
# En el VPS, detrás del proxy del correo: 172.22.1.1
# BIND_HOST=172.22.1.1
CURRENCY=clp
DEFAULT_GATEWAY=chile
PUBLIC_BASE_URL=http://localhost:3000
# Correo público para consultas de patrocinio y alianzas.
PUBLIC_CONTACT_EMAIL=patrocinios@proveedorregional.cl
# SMTP saliente (opcional): necesario para recibir consultas desde el formulario público.
# MAIL_HOST=mail.proveedorregional.cl
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_SMTP_PORT=587
# Base local. Sobrevive al reinicio. En tests se usa :memory:.
DATABASE_PATH=data/platform.db
# Clave inicial de operación, comercio y titular. Solo se usa si todavía no hay usuarios.
# AUTH_SEED_PASSWORD=

# Mailcow API (opcional): habilita la creación y listado de buzones desde Correo.
# Genera una API key Mailcow y permite la IP de egreso de este servidor.
# MAILCOW_API_URL debe ser el origen HTTPS (sin /api ni rutas).
MAILCOW_API_URL=
MAILCOW_API_KEY=
MAILCOW_DOMAIN=proveedorregional.cl

# Stripe (opcional): si se define, se usa la API real de Stripe.
# Obtén llaves de prueba sin cuenta con: npm i -g @stripe/cli && stripe sandbox create --from-git
STRIPE_SECRET_KEY=
# Llave publicable (pk_test_). El portal la usa para montar Checkout embebido.
STRIPE_PUBLISHABLE_KEY=
# Secreto de firma de webhooks (lo entrega `stripe listen`).
STRIPE_WEBHOOK_SECRET=

# Pasarela chilena (opcional): Webpay/Khipu/Flow.
CHILE_GATEWAY_API_KEY=
CHILE_GATEWAY_COMMERCE_CODE=

# Cifrado en reposo de clientSecret de Global66 por empresa.
# Genera un valor aleatorio fuerte (p. ej. 32 bytes) y guárdalo solo en el VPS.
GLOBAL66_CREDENTIALS_ENCRYPTION_KEY=

# Planificador IA de pilotos (opcional). Usa Databricks Unity Gateway desde el servidor.
# Crea un service principal OAuth M2M con acceso de consulta al Model Service system.ai.gpt-6-luna.
# No uses tokens personales; guarda el secreto OAuth solo en el entorno del VPS.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Model Service disponible en el workspace. No crea un endpoint dedicado.
DATABRICKS_PILOT_MODEL=databricks-gpt-6-luna

# Remesas: cobro con tarjeta en el POS TUU (inter-app) y envío por la API transaccional de Global66.
# API key de TUU (Workspace > Pagos > Configuración > API). Confirma cada pago en los reportes TUU
# antes de enviar dinero. Sin ella, en producción cada remesa espera la aprobación de Operación.
TUU_API_KEY=
# dteType que recibe la app de pago TUU: 48 = boleta electrónica (confírmalo con TUU), 0 = sin documento.
TUU_DTE_TYPE=48
# send = el monto remitido va como exento en la boleta y solo se grava la comisión; none = boleta por el total.
REMESAS_DTE_EXEMPT=send
# Minutos de aprobación de fondos entre el pago en el POS y el envío desde Global66.
REMESAS_SEND_DELAY_MINUTES=30
# Catálogo público de Global66 (países, bancos, campos del beneficiario, SLA). Vacío = copia incluida.
# GLOBAL66_CATALOG_URL=https://api.global66.com
# Credencial B2B de Global66 (Empresas > Integraciones API). Registra la IP de salida del VPS.
GLOBAL66_B2B_CLIENT_ID=
GLOBAL66_B2B_CLIENT_SECRET=
# walletId de la cuenta CLP de SICR3P en Global66 (GET /b2b/accounts). Vacío = la CLP principal.
GLOBAL66_B2B_ACCOUNT_ID=
# x-api-key que Global66 asigna al webhook https://<tu dominio>/webhooks/global66
GLOBAL66_WEBHOOK_API_KEY=
# Propósito de envío habilitado para tu empresa en Global66.
GLOBAL66_REMITTANCE_PURPOSE_CODE=1
# 1 = envía al cliente como remitente (endpoint RaaS, Global66 lo habilita por empresa). 0 = la empresa es la remitente.
GLOBAL66_RAAS=1
# Total máximo (CLP) que se envía sin aprobación de Operación. Vacío = sin límite.
REMESAS_AUTO_SEND_MAX=
